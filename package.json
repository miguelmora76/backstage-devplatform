{
  "name": "backstage-devplatform",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "tsc": "tsc && tsc -p packages/plugin-guardrails && tsc -p packages/app && tsc -p packages/e2e",
    "start:local": "node packages/backend/scripts/start-local.mjs",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "test": "backstage-cli repo test",
    "lint": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "compose:up": "node packages/e2e/bin/compose-up.mjs",
    "compose:down": "node packages/e2e/bin/compose-down.mjs",
    "compose:reset": "node packages/e2e/bin/compose-reset.mjs",
    "minikube:up": "node packages/e2e/bin/minikube-up.mjs",
    "minikube:down": "node packages/e2e/bin/minikube-down.mjs",
    "e2e": "node packages/e2e/bin/e2e.mjs",
    "e2e:timing": "node packages/e2e/bin/e2e-timing.mjs"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/cli-defaults": "^0.1.7",
    "@jest/environment-jsdom-abstract": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "lines": 85
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ]
  },
  "prettier": "@backstage/cli/config/prettier"
}
