# Copy this file to `.env` (it is ignored by git) and fill in what you need.
# `yarn start:local` loads `.env` before it starts the app. These are samples
# for a local run; never put a real secret in this file.

# Required. The address of the guardrails server (u1) as seen from the backend.
GUARDRAILS_SERVER_URL=http://localhost:7100

# Off unless set to true. The demo sign-in lets anyone who can open the page
# sign in as any of the three demo users without a password. Use it only in a
# local demo. `yarn start:local --demo` turns it on for that run only.
GUARDRAILS_DEMO_SIGN_IN=false

# The app's own addresses and the backend port (local development values).
APP_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:7007
BACKEND_PORT=7007

# PostgreSQL is used only when app-config.postgres.yaml is added to the start
# command (the compose run does this). All five are then required; the compose
# files supply them from their own env file. Do not write a password here.
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
