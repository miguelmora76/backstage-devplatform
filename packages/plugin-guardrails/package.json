{
  "name": "plugin-guardrails",
  "version": "0.1.0",
  "description": "Guardrails frontend plugin: overview card, Guardrails tab, change detail and demo-user switch",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "guardrails",
    "pluginPackages": [
      "plugin-guardrails",
      "plugin-guardrails-backend"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "backstage-cli package lint",
    "test": "TZ=Europe/Berlin backstage-cli package test --watchAll=false",
    "check:packages": "node scripts/check-packages.mjs",
    "check:built": "node scripts/check-built.mjs",
    "clean": "backstage-cli package clean",
    "contract:check": "TZ=Europe/Berlin backstage-cli package test --watchAll=false src/testing/standIn"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@backstage/frontend-plugin-api": "^0.18.2",
    "@backstage/plugin-catalog-react": "^3.3.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/lab": "^4.0.0-alpha.61"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/test-utils": "^1.7.23",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jest-axe": "^11.0.0",
    "msw": "^3.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.30.2",
    "react-router-dom": "^6.30.2",
    "yaml": "^2.9.1"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/*.test.{ts,tsx}",
      "!**/testing/**",
      "!**/setupTests.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/../jestGlobalSetup.js"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2"
  }
}
