{
  "extends": "./tsconfig.json",
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/testing/**",
    "src/setupTests.ts"
  ],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": false,
    "incremental": false,
    "target": "ES2022",
    "types": ["node"]
  }
}
