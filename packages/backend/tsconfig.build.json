{
  "extends": "../../tsconfig.json",
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/testing/**"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": false,
    "incremental": false,
    "declaration": false,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"]
  }
}
