{
  "name": "backend",
  "version": "0.1.0",
  "description": "Backstage backend for the guardrails sample: catalog, auth with the demo sign-in, the guardrails plugin and the app backend",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "backstage": {
    "role": "backend"
  },
  "scripts": {
    "start": "backstage-cli package start --config app-config.yaml",
    "start:postgres": "backstage-cli package start --config app-config.yaml --config app-config.postgres.yaml",
    "build": "tsc -p tsconfig.build.json",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --watchAll=false",
    "catalog:write": "yarn build && node dist/scripts/writeCatalog.js",
    "catalog:check": "backstage-cli package test --watchAll=false src/catalog",
    "check:settings": "yarn build && node dist/scripts/checkSettings.js",
    "check:packages": "node scripts/check-packages.mjs",
    "check:exit": "node scripts/check-exit.mjs",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/backend-defaults": "^0.18.1",
    "@backstage/plugin-app-backend": "^0.5.19",
    "@backstage/plugin-auth-backend": "^0.30.2",
    "@backstage/plugin-auth-node": "^0.7.7",
    "@backstage/plugin-catalog-backend": "^4.0.2",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.1",
    "plugin-guardrails-backend": "^0.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@backstage/backend-plugin-api": "^1.11.0",
    "@backstage/backend-test-utils": "^1.11.8",
    "@backstage/cli": "^0.36.7",
    "@types/node": "^24.19.2",
    "guardrails-server": "^0.1.0"
  },
  "files": [
    "dist",
    "catalog",
    "app-config.yaml",
    "app-config.postgres.yaml"
  ],
  "jest": {
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.d.ts",
      "!**/*.test.ts",
      "!index.ts",
      "!main.ts",
      "!scripts/**",
      "!**/testing/**",
      "!**/lintFixtures/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "testTimeout": 30000
  }
}
