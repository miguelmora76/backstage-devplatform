{
  "name": "plugin-guardrails-backend",
  "version": "0.1.0",
  "description": "Guardrails backend plugin: demo sign-in, propose and decide flow with an atomic claim, append-only audit log, and the plan and failed-run relay",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "guardrails",
    "pluginPackages": [
      "plugin-guardrails-backend"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --watchAll=false",
    "contract:check": "backstage-cli package test --watchAll=false src/contract/contract.test.ts",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.11.0",
    "@backstage/errors": "^1.3.2",
    "@backstage/plugin-auth-node": "^0.7.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "express": "^4.22.0",
    "express-promise-router": "^4.1.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.8",
    "@backstage/cli": "^0.36.7",
    "@types/express": "^4.17.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "guardrails-server": "^0.1.0",
    "supertest": "^7.3.2",
    "yaml": "^2.2.2"
  },
  "files": [
    "dist",
    "migrations",
    "contract",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "jest": {
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.d.ts",
      "!**/*.test.ts",
      "!**/testing/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "testTimeout": 30000
  }
}
