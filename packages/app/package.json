{
  "name": "app",
  "version": "0.1.0",
  "description": "Backstage frontend for the guardrails sample: catalog pages, demo sign-in page and the guardrails plugin",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "backstage": {
    "role": "frontend"
  },
  "scripts": {
    "start": "backstage-cli package start --config ../backend/app-config.yaml",
    "build": "backstage-cli package build --config ../backend/app-config.yaml",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --watchAll=false",
    "check:packages": "node ../backend/scripts/check-packages.mjs .",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/frontend-defaults": "^0.5.7",
    "@backstage/frontend-plugin-api": "^0.18.2",
    "@backstage/plugin-app": "^0.5.4",
    "@backstage/plugin-app-react": "^0.2.8",
    "@backstage/plugin-catalog": "^2.0.10",
    "@backstage/plugin-user-settings": "^0.9.8",
    "@backstage/ui": "^0.19.0",
    "@material-ui/core": "^4.12.4",
    "plugin-guardrails": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/test-utils": "^1.7.23",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jest-axe": "^11.0.0"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/*.test.{ts,tsx}",
      "!index.{ts,tsx}",
      "!App.tsx",
      "!setupTests.ts",
      "!**/testing/**",
      "!**/lintFixtures/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/../jestGlobalSetup.js"
  }
}
