{
  "name": "guardrails-server",
  "version": "0.1.0",
  "description": "Synthetic guardrails MCP server and seeded data generator for the Backstage guardrails sample",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "backstage": {
    "role": "node-library"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --watchAll=false",
    "generate": "node dist/generator/cli.js",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@types/node": "^24.19.2"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.d.ts",
      "!**/*.test.ts",
      "!**/testing/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "testTimeout": 30000
  }
}
