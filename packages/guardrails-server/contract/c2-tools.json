{
  "contract": "C2",
  "title": "Guardrails server tool interface (u1 to u2)",
  "owner": "u1-data-and-server",
  "endpoint": "/mcp",
  "transport": "streamable-http",
  "retries": "none",
  "errorCodes": [
    "UNKNOWN_SERVICE",
    "UNKNOWN_DEPENDENCY",
    "UNKNOWN_RUN",
    "INVALID_INPUT",
    "FORCED_FAILURE",
    "INTERNAL_ERROR"
  ],
  "errorResult": {
    "description": "A failed call returns a tool result with isError true. The structured content holds the code and message; the text content holds the same message.",
    "structuredContent": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  },
  "failureMode": {
    "description": "Start-up setting, not a tool. With it on, every tool returns FORCED_FAILURE. Tests switch it by restarting the container.",
    "setting": "GUARDRAILS_FAILURE_MODE",
    "values": ["on", "off"],
    "default": "off"
  },
  "tools": [
    {
      "name": "list_upgrade_plan",
      "kind": "read",
      "timeoutMs": 3000,
      "idempotent": true,
      "input": {
        "type": "object",
        "required": ["service"],
        "properties": { "service": { "type": "string" } }
      },
      "output": {
        "type": "object",
        "required": ["service", "dependencies"],
        "properties": {
          "service": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dependencyKey",
                "name",
                "currentVersion",
                "recommendedVersion"
              ],
              "properties": {
                "dependencyKey": { "type": "string" },
                "name": { "type": "string" },
                "currentVersion": { "type": "string" },
                "recommendedVersion": { "type": "string" }
              }
            }
          }
        }
      },
      "errors": [
        "UNKNOWN_SERVICE",
        "INVALID_INPUT",
        "FORCED_FAILURE",
        "INTERNAL_ERROR"
      ]
    },
    {
      "name": "list_failed_ci_runs",
      "kind": "read",
      "timeoutMs": 3000,
      "idempotent": true,
      "input": {
        "type": "object",
        "required": ["service"],
        "properties": { "service": { "type": "string" } }
      },
      "output": {
        "type": "object",
        "required": ["service", "runs"],
        "properties": {
          "service": { "type": "string" },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["runKey", "runNumber", "status", "cause"],
              "properties": {
                "runKey": { "type": "string" },
                "runNumber": { "type": "integer" },
                "status": { "type": "string" },
                "cause": { "type": "string" }
              }
            }
          }
        }
      },
      "errors": [
        "UNKNOWN_SERVICE",
        "INVALID_INPUT",
        "FORCED_FAILURE",
        "INTERNAL_ERROR"
      ]
    },
    {
      "name": "apply_dependency_upgrade",
      "kind": "write",
      "timeoutMs": 10000,
      "idempotent": true,
      "idempotentNote": "Already at the recommended version succeeds as a no-op (result already-current).",
      "input": {
        "type": "object",
        "required": ["service", "dependencyKey"],
        "properties": {
          "service": { "type": "string" },
          "dependencyKey": { "type": "string" }
        }
      },
      "output": {
        "type": "object",
        "required": ["dependencyKey", "currentVersion", "result"],
        "properties": {
          "dependencyKey": { "type": "string" },
          "currentVersion": { "type": "string" },
          "result": { "type": "string", "enum": ["applied", "already-current"] }
        }
      },
      "errors": [
        "UNKNOWN_SERVICE",
        "UNKNOWN_DEPENDENCY",
        "INVALID_INPUT",
        "FORCED_FAILURE",
        "INTERNAL_ERROR"
      ]
    },
    {
      "name": "rerun_ci_job",
      "kind": "write",
      "timeoutMs": 10000,
      "idempotent": true,
      "idempotentNote": "A repeat returns the same result and changes nothing more; this replaces the earlier idempotent false.",
      "input": {
        "type": "object",
        "required": ["service", "runKey"],
        "properties": {
          "service": { "type": "string" },
          "runKey": { "type": "string" }
        }
      },
      "output": {
        "type": "object",
        "required": ["runKey", "result"],
        "properties": {
          "runKey": { "type": "string" },
          "result": { "type": "string", "enum": ["rerun-started"] }
        }
      },
      "errors": [
        "UNKNOWN_SERVICE",
        "UNKNOWN_RUN",
        "INVALID_INPUT",
        "FORCED_FAILURE",
        "INTERNAL_ERROR"
      ]
    }
  ]
}
